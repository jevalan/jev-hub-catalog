{
  "repo": "tamaratran/fast-jev-compaction",
  "branch": "main",
  "tree": [
    ".claude-plugin/marketplace.json",
    ".claude-plugin/plugin.json",
    ".gitignore",
    "LICENSE",
    "README.md",
    "demo/JevDemo/Info.plist",
    "demo/JevDemo/build.sh",
    "demo/JevDemo/main.swift",
    "examples/demo.ts",
    "hooks/README.md",
    "hooks/fast-jev.ts",
    "hooks/hooks.json",
    "package-lock.json",
    "package.json",
    "src/client.ts",
    "src/compact.ts",
    "src/index.ts",
    "src/messages.ts",
    "src/request.ts",
    "src/state.ts",
    "src/types.ts",
    "tests/fast-jev-compaction.test.ts",
    "tests/hook.test.ts",
    "tsconfig.hooks.json",
    "tsconfig.json",
    "types/claude-code.d.ts"
  ],
  "manifests": {
    "package.json": {
      "name": "fast-jev-compaction",
      "version": "0.2.0",
      "description": "Continuous, verbatim context compaction for LLM agents using TypeSafe's Jev model.",
      "type": "module",
      "license": "MIT",
      "engines": {
        "node": ">=18"
      },
      "exports": {
        ".": {
          "types": "./dist/index.d.ts",
          "import": "./dist/index.js"
        }
      },
      "files": [
        "dist",
        "README.md",
        "LICENSE"
      ],
      "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit && npm run typecheck:hooks",
        "test": "vitest run",
        "demo": "tsx examples/demo.ts",
        "typecheck:hooks": "tsc -p tsconfig.hooks.json",
        "validate:plugin": "claude plugin validate .claude-plugin/plugin.json"
      },
      "devDependencies": {
        "@types/node": "^22.10.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vitest": "^2.1.8"
      }
    }
  }
}
