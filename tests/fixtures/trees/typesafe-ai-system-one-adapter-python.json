  "manifests": {
    "pyproject.toml": "[project]\nname = \"system-one-adapter\"\nversion = \"0.2.1\"\ndescription = \"Drop-in TypeSafeClient replacement backed by LLM APIs\"\nreadme = \"README.md\"\nlicense = \"MIT\"\nlicense-files = [\"LICENSE\"]\nauthors = [\n    { name = \"TypeSafe AI\", email = \"support@typesafe.ai\" }\n]\nmaintainers = [\n    { name = \"Erik Gafni\", email = \"erik@typesafe.ai\" },\n    { name = \"Daniel Gafni\", email = \"daniel@typesafe.ai\" }\n]\nrequires-python = \">=3.10\"\nkeywords = [\"typesafe\", \"llm\", \"openai\", \"anthropic\", \"gemini\", \"ai\"]\nclassifiers = [\n    \"Typing :: Typed\",\n    \"Development Status :: 5 - Production/Stable\",\n    \"Intended Audience :: Developers\",\n    \"Operating System :: OS Independent\",\n    \"Operating System :: POSIX\",\n    \"Operating System :: MacOS\",\n    \"Operating System :: POSIX :: Linux\",\n    \"Operating System :: Microsoft :: Windows\",\n    \"Programming Language :: Python :: 3 :: Only\",\n    \"Programming Language :: Python :: 3.10\",\n    \"Programming Language :: Python :: 3.11\",\n    \"Programming Language :: Python :: 3.12\",\n    \"Programming Language :: Python :: 3.13\",\n    \"Programming Language :: Python :: 3.14\",\n    \"Topic :: Scientific/Engineering :: Artificial Intelligence\",\n    \"Topic :: Software Development :: Libraries :: Python Modules\",\n]\ndependencies = [\n    \"pydantic>=2.12.0\",\n    \"pydantic-core>=2.41.1\",\n    \"tenacity>=8.0.0\",\n    \"typesafe-sdk>=0.7.0\",\n    \"typing-extensions>=4.0.0\",\n]\n\n[project.urls]\nRepository = \"https://github.com/typesafe-ai/system-one-adapter-python\"\nIssues = \"https://github.com/typesafe-ai/system-one-adapter-python/issues\"\nChangelog = \"https://github.com/typesafe-ai/system-one-adapter-python/blob/main/docs/changelog.md\"\n\n[project.optional-dependencies]\nopenai = [\n    \"openai>=2.53.0\",\n]\nanthropic = [\n    \"anthropic>=0.121.0\",\n]\ngemini = [\n    \"google-genai>=2.24.0\",\n]\n\n[dependency-groups]\ndev = [\n    \"httpx>=0.28.1\",\n    \"pyrefly>=1.2.0\",\n    \"pytest>=9.0.2\",\n    \"pytest-recording>=0.13.4\",\n    \"ruff>=0.16.6\",\n    \"tach>=0.35.0\",\n    \"vcrpy>=8.3.0\",\n]\n\n[tool.uv.build-backend]\nmodule-name = \"system_one_adapter\"\n\n[[tool.uv.index]]\nname = \"testpypi\"\nurl = \"https://test.pypi.org/simple/\"\npublish-url = \"https://test.pypi.org/legacy/\"\nexplicit = true\n\n[tool.pytest.ini_options]\ntestpaths = [\"tests\"]\n# Fail rather than silently making a live call when a cassette is missing. Passing\n# --record-mode (anything but \"none\") lifts this for cassette-backed tests. The tach\n# pytest plugin is disabled; boundaries are checked by `tach check`, not at test time.\naddopts = \"--block-network -p no:tach\"\n\n[build-system]\nrequires = [\"uv_build>=0.12.5,<0.13\"]\nbuild-backend = \"uv_build\"\n"
  }
