  "manifests": {
    "Cargo.toml": "[package]\nname = \"skillranker\"\nversion = \"0.1.0\"\nedition = \"2024\"\nrust-version = \"1.95\"\ndescription = \"Session-specific skill advice powered by TypeSafe.ai Jev\"\nlicense-file = \"LICENSE\"\nrepository = \"https://github.com/Dicklesworthstone/skillranker\"\npublish = false\n\n[[bin]]\nname = \"sr\"\npath = \"src/main.rs\"\n\n[features]\ndefault = []\n# Reserved boundary; no TUI implementation or terminal dependency ships yet.\ntui = []\n\n[dependencies]\nasupersync = { version = \"=0.5.0\", default-features = false, features = [\"runtime-core\", \"native-runtime\", \"tls-native-roots\"] }\nblake3 = \"1.8\"\nclap = { version = \"4\", default-features = false, features = [\"std\"] }\ndirectories = \"=6.0.0\"\nhttpdate = \"=1.0.3\"\nfrankensearch-core = { git = \"https://github.com/Dicklesworthstone/frankensearch.git\", rev = \"39047c44c3a92ceb71d25c602913b8b2888e2fe7\", default-features = false }\nfrankensearch-quill = { git = \"https://github.com/Dicklesworthstone/frankensearch.git\", rev = \"39047c44c3a92ceb71d25c602913b8b2888e2fe7\", default-features = false }\nnix = { version = \"0.31\", default-features = false, features = [\"dir\", \"fs\", \"poll\", \"process\", \"signal\", \"user\"] }\nregex = \"1.13.1\"\nrusqlite = { version = \"=0.40.2\", default-features = false, features = [\"bundled\", \"hooks\", \"limits\"] }\nserde = { version = \"1.0\", features = [\"derive\"] }\nserde_json = { version = \"1.0\", features = [\"float_roundtrip\"] }\ntoml = { version = \"1\", default-features = false, features = [\"parse\", \"serde\"] }\n\n[build-dependencies]\nblake3 = \"1.8\"\n\n# Quill's Cx and our Cx must come from exactly the same package source.\n[patch.crates-io]\nasupersync = { git = \"https://github.com/Dicklesworthstone/asupersync\", rev = \"81fb7b579ce5f161622f1524391f5202a641cc2e\" }\n\n[lints.rust]\nunsafe_code = \"forbid\"\n\n[lints.clippy]\nall = \"warn\"\n"
  }
